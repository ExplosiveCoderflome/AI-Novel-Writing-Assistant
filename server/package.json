{
  "name": "@ai-novel/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/app.js",
  "files": [
    "dist",
    "src/prisma/migrations",
    "src/prisma/migrations.sqlite",
    "src/prisma/schema.prisma",
    "src/prisma/schema.sqlite.prisma"
  ],
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "scripts": {
    "dev": "pnpm run dev:api",
    "dev:api": "node scripts/ensure-dev-prisma.cjs && node scripts/stop-stale-dev-server.cjs && tsx watch --clear-screen=false --include src/prisma/schema.sqlite.prisma --include src/prisma/schema.prisma --require ./scripts/ensure-dev-prisma.cjs src/app.ts",
    "build": "node ../node_modules/typescript-legacy/bin/tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "start:api": "node dist/app.js",
    "typecheck": "pnpm prisma:generate && node ../node_modules/typescript-legacy/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node ../node_modules/typescript-legacy/bin/tsc -p tsconfig.json --noEmit && node scripts/quality/check-code-policy.cjs",
    "test:quality": "node scripts/quality/run-gate.cjs",
    "test": "pnpm --filter @ai-novel/shared build && pnpm run build && pnpm run test:node",
    "test:node": "node scripts/run-tests.cjs fast",
    "test:integration": "pnpm --filter @ai-novel/shared build && pnpm run build && node scripts/run-tests.cjs integration",
    "test:all": "pnpm prisma:generate && pnpm --filter @ai-novel/shared build && pnpm run build && node scripts/run-tests.cjs all",
    "test:planner": "pnpm --filter @ai-novel/shared build && pnpm run build && node --test tests/planner.test.js",
    "test:tools": "pnpm --filter @ai-novel/shared build && pnpm run build && node --test tests/tools.test.js",
    "test:runtime": "pnpm --filter @ai-novel/shared build && pnpm run build && node --test tests/runtime.test.js",
    "test:routes": "pnpm --filter @ai-novel/shared build && pnpm run build && node --test tests/routes.test.js",
    "test:book-analysis": "pnpm --filter @ai-novel/shared build && pnpm run build && node --test tests/bookAnalysis.test.js",
    "compat:check": "node scripts/model-compat-check.cjs",
    "rag:eval": "node scripts/rag-retrieval-eval.cjs",
    "audit:director-recovery-samples": "node scripts/director-recovery-sample-audit.cjs",
    "backfill:director-draft-baselines": "node scripts/director-chapter-draft-baseline-backfill.cjs",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:push": "prisma db push --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --name init --config prisma.config.ts",
    "db:migrate": "pnpm prisma:migrate",
    "db:seed": "prisma db seed --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "db:restore": "node scripts/restore-dev-data.cjs",
    "db:prune-snapshots": "node scripts/prune-snapshots.cjs",
    "prisma:deploy:postgres": "node ../scripts/deploy-prisma-postgres.cjs"
  },
  "dependencies": {
    "@ai-novel/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.5.0",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/openai": "^1.8.5",
    "@larksuiteoapi/node-sdk": "^1.77.0",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "^7.4.2",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "js-tiktoken": "1.0.21",
    "langchain": "^1.6.7",
    "morgan": "^1.12.1",
    "sharp": "^0.35.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.9",
    "prisma": "^7.4.2",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "yauzl": "^3.4.0"
  }
}
