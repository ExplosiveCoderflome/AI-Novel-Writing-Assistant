{
  "name": "@ai-novel/site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-manuscript.mjs && node scripts/sync-architecture-assets.cjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-manuscript.mjs && node scripts/sync-architecture-assets.cjs && node scripts/generate-sitemap.cjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/prerender.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.576.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8"
  }
}
