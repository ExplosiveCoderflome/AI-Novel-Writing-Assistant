  "cards": [
    {
      "dot": "cyan",
      "title": "执行主链",
      "items": [
        "用户操作先进入持久化导演命令，再由租约 Worker 执行",
        "自动导演负责跨阶段编排，章节流水线负责单章生成到最终提交",
        "模型调用统一经过 Prompt Registry 与结构化输出边界"
      ]
    },
    {
      "dot": "emerald",
      "title": "恢复与可见性",
      "items": [
        "任务、检查点、事件和章节结果落入同一持久状态层",
        "导演快照基于运行事件与事实检查生成，不由前端猜测状态",
        "运行记录负责查看与导航，创作页承载继续、恢复和修复动作"
      ]
    },
    {
      "dot": "amber",
      "title": "复杂度热点",
      "items": [
        "自动导演横跨命令、运行时、自动执行、投影和恢复多个子模块",
        "工作流任务状态与导演运行快照需要持续保持一致并支持修复",
        "局部章节质量问题必须沉淀为质量债务，不能误停整书执行链"
      ]
    }
  ]
