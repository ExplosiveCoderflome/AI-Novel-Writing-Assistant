{
  "name": "@ai-novel/desktop",
  "version": "0.8.13",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Biz Studio",
  "description": "Windows desktop runtime for Biz Novel Studio",
  "productName": "Biz Novel Studio",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare:runtime": "node scripts/ensure-electron-runtime.cjs --install",
    "verify:runtime": "node scripts/ensure-electron-runtime.cjs",
    "build": "node ../node_modules/typescript-legacy/bin/tsc -p tsconfig.json",
    "typecheck": "node ../node_modules/typescript-legacy/bin/tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run prepare:runtime && pnpm run build && electron dist/main.js",
    "start": "pnpm run prepare:runtime && electron dist/main.js"
  },
  "dependencies": {
    "@ai-novel/server": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "electron": "^35.7.5",
    "electron-builder": "^26.1.0",
    "typescript": "7.1.0-beta"
  }
}
